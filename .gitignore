# 本机运行产物，不入库
devices.json
wins.txt
*.log
*.output
.show-request
.DS_Store

# WorkBuddy 本地项目数据（记忆/日志等），不入库
.workbuddy/

# 本地 agent 工具临时目录（会话配置/验证报告），不入库
.arts/
.resultverify/

# 个人本地文档（README.md 是它的公开脱敏版）
使用说明.md

# 开发/验证脚手架：里面是作者本机的路径与设备地址
_dev/

# macOS Web UI 运行产物，不入库
server.err
.server-port

# 封装构建产物与输入源压缩包
packaging/staging/
packaging/macos/staging/
packaging/downloads/
dist/
packaging/windows/Dist/
packaging/windows/dist/
*.exe

# Windows WPF (.NET) 工程的构建产物：源码入库，编译出来的东西不入库
packaging/windows/dotnet/**/bin/
packaging/windows/dotnet/**/obj/
packaging/windows/dotnet/publish/
packaging/windows/Dist/smoke/
.vs/
*.user

# 成品一律走 GitHub Releases（双平台 zip），仓库不保留任何二进制产物；
# 本地 dist/ 与 Dist/ 产物由上方规则忽略，打包工作流照常产出。
