<Window x:Class="ScrcpyPicker.Views.NavBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导航键"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">

    <!-- 导航条：吸附在投屏窗口下沿的一条悬浮按键面板（对应 macOS 的 NavBar HUD）。
         三键手机的投屏画面里没有返回/桌面/多任务，人在电脑前就没法"回家"，
         所以这几个键必须一直在手边，而不是藏在设备行的右键菜单里。
         深色自绘、不跟随系统主题：它要压在任意颜色的投屏画面上还看得清。 -->

    <Window.Resources>
        <Style x:Key="NavBig" TargetType="Button">
            <Setter Property="Width" Value="74" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FFEDEDF0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FF2E2E38" BorderBrush="#FF4A4A56"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3F3F4C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3F6FB5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSmall" TargetType="Button" BasedOn="{StaticResource NavBig}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="27" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFB9B9C4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" AutomationProperties.AutomationId="navShell"
            Background="#F21E1E26" BorderBrush="#FF45454F"
            BorderThickness="1" CornerRadius="12" Padding="10,7">
        <!-- WrapPanel 而不是 StackPanel：吸附时条子的宽度被投屏窗口钉住，
             竖屏窄窗口下七颗键必须折成两行，不能被裁掉。 -->
        <WrapPanel x:Name="Flow" Orientation="Horizontal"
                   VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="NavTitle" AutomationProperties.AutomationId="navTitle"
                       Text="导航键" Foreground="#FF8F8F9B" FontSize="11"
                       VerticalAlignment="Center" Margin="2,0,11,0" />
            <StackPanel x:Name="RowMain" Orientation="Horizontal" VerticalAlignment="Center">
                <Button AutomationProperties.AutomationId="btnNavBack" Style="{StaticResource NavBig}"
                        Content="返回" Tag="4" Click="OnKeyClick"
                        ToolTip="返回上一级（等价于在投屏窗口点右键 / Alt+B）" />
                <Button AutomationProperties.AutomationId="btnNavHome" Style="{StaticResource NavBig}"
                        Content="桌面" Tag="3" Click="OnKeyClick"
                        ToolTip="回桌面（等价于投屏窗口中键 / Alt+H）" />
                <Button AutomationProperties.AutomationId="btnNavOverview" Style="{StaticResource NavBig}"
                        Content="多任务" Tag="187" Click="OnKeyClick"
                        ToolTip="最近任务（等价于 Alt+S）" />
            </StackPanel>
            <StackPanel x:Name="RowMinor" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                <Button AutomationProperties.AutomationId="btnNavVolDown" Style="{StaticResource NavSmall}"
                        Content="音量-" Tag="25" Click="OnKeyClick" ToolTip="音量减" />
                <Button AutomationProperties.AutomationId="btnNavVolUp" Style="{StaticResource NavSmall}"
                        Content="音量+" Tag="24" Click="OnKeyClick" ToolTip="音量加" />
                <Button AutomationProperties.AutomationId="btnNavSleep" Style="{StaticResource NavSmall}"
                        Content="息屏" Tag="223" Click="OnKeyClick" ToolTip="关闭屏幕，投屏保持连接" />
                <Button AutomationProperties.AutomationId="btnNavWake" Style="{StaticResource NavSmall}"
                        Content="唤醒" Tag="224" Click="OnKeyClick" ToolTip="点亮屏幕" />
            </StackPanel>
            <Button x:Name="NavClose" AutomationProperties.AutomationId="btnNavClose"
                    Content="&#x2715;" Width="20" Height="20" FontSize="11"
                    VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#FF8F8F9B"
                    Cursor="Hand" Background="Transparent" BorderThickness="0" Click="OnCloseClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="#FF5A3030" />
                                <Setter Property="Foreground" Value="#FFFFDADA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </WrapPanel>
    </Border>
</Window>
