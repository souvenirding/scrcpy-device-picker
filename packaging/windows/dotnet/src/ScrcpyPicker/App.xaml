<Application x:Class="ScrcpyPicker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <!-- ShutdownMode 显式写 OnMainWindowClose：导航条自己也是窗口，用默认的 OnLastWindowClose
         会出现"主窗口关了、进程还挂在一条看不见的按钮条上"的幽灵状态。
         这里没写 StartupUri：命令行参数（-tools、-no-scan、selftest）要先解析，
         窗口由 OnStartup 里手工建，headless 分支根本不建窗口。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
